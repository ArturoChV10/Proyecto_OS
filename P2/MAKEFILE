CC  = gcc
CXX = g++
CFLAGS   = -Wall -Wextra -g
CXXFLAGS = -Wall -Wextra -g
SRCDIR   = src
OBJDIR   = obj

# ---- Target principal ----
all: jqindex

# Compilar los modulos C a .o con gcc
$(OBJDIR)/json_parser.o: $(SRCDIR)/json_parser.c $(SRCDIR)/json_parser.h
	@mkdir -p $(OBJDIR)
	$(CC) $(CFLAGS) -c $(SRCDIR)/json_parser.c -o $(OBJDIR)/json_parser.o

$(OBJDIR)/indexer.o: $(SRCDIR)/indexer.c $(SRCDIR)/indexer.h
	@mkdir -p $(OBJDIR)
	$(CC) $(CFLAGS) -c $(SRCDIR)/indexer.c -o $(OBJDIR)/indexer.o

$(OBJDIR)/searcher.o: $(SRCDIR)/searcher.c $(SRCDIR)/searcher.h
	@mkdir -p $(OBJDIR)
	$(CC) $(CFLAGS) -c $(SRCDIR)/searcher.c -o $(OBJDIR)/searcher.o

# Compilar el .cpp y enlazar todo con g++
jqindex: $(SRCDIR)/jqindex.cpp $(OBJDIR)/json_parser.o $(OBJDIR)/indexer.o $(OBJDIR)/searcher.o
	$(CXX) $(CXXFLAGS) -o jqindex \
		$(SRCDIR)/jqindex.cpp \
		$(OBJDIR)/json_parser.o \
		$(OBJDIR)/indexer.o \
		$(OBJDIR)/searcher.o

# ---- Targets de prueba individuales ----
test_parser: $(SRCDIR)/test_parser.c $(OBJDIR)/json_parser.o
	$(CC) $(CFLAGS) -o test_parser $(SRCDIR)/test_parser.c $(OBJDIR)/json_parser.o

test_indexer: $(SRCDIR)/test_indexer.c $(OBJDIR)/json_parser.o $(OBJDIR)/indexer.o
	$(CC) $(CFLAGS) -o test_indexer \
		$(SRCDIR)/test_indexer.c \
		$(OBJDIR)/json_parser.o \
		$(OBJDIR)/indexer.o

test_searcher: $(SRCDIR)/test_searcher.c $(OBJDIR)/searcher.o $(OBJDIR)/indexer.o $(OBJDIR)/json_parser.o
	$(CC) $(CFLAGS) -o test_searcher \
		$(SRCDIR)/test_searcher.c \
		$(OBJDIR)/searcher.o \
		$(OBJDIR)/indexer.o \
		$(OBJDIR)/json_parser.o

# ---- Limpieza ----
clean:
	rm -rf $(OBJDIR)
	rm -f jqindex test_parser test_indexer test_searcher
	rm -f tests/*.jnx

.PHONY: all clean
